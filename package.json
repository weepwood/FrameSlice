{
  "name": "frameslice",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build && npm --prefix apps/caption-studio run build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs && npm --prefix apps/caption-studio test",
    "stress:virtual": "node --expose-gc scripts/stress-virtual.mjs",
    "stress:real": "node scripts/stress-real.mjs",
    "dev:caption": "npm --prefix apps/caption-studio run dev -- --host 127.0.0.1 --port 5174",
    "build:caption": "npm --prefix apps/caption-studio run build"
  },
  "dependencies": {
    "lucide-vue-next": "^0.468.0",
    "mediabunny": "1.66.2",
    "reka-ui": "2.11.0",
    "vue": "^3.5.20"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vue-tsc": "^3.1.0",
    "esbuild": "^0.25.12"
  },
  "engines": {
    "node": ">=22.12"
  }
}
